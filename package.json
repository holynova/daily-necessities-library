{
  "name": "daily-necessities-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static gallery created through the build-gallery skill.",
  "scripts": {
    "dev": "astro dev",
    "images": "npm run ingest",
    "ingest": "tsx scripts/ingest.ts",
    "validate": "tsx scripts/validate.ts",
    "check": "astro check",
    "test": "vitest run",
    "build": "npm run ingest && npm run validate && astro build",
    "preview": "astro preview",
    "deploy:cloudflare": "npm run build && npx wrangler deploy --config wrangler.toml"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "js-yaml": "^4.1.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}